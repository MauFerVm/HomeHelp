# ============================================================
#  server/.env.example  –  Variables de entorno del backend
#  Copiá este archivo a .env y completá con tus valores reales
# ============================================================

# Puerto del servidor Express
PORT=3002

# Base de datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=home_help1
DB_PORT=3306

# SMTP para envío de correos
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=HomeHelp <noreply@midominio.com>

